<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:MultiTool.Modules.GameMode"
             xmlns:abs="using:MultiTool.Abstractions"
             mc:Ignorable="d"
             x:Class="MultiTool.Modules.GameMode.GameModeView"
             x:DataType="local:GameModeViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://MultiTool.Modules.GameMode/Styles.axaml" />
  </UserControl.Styles>

  <ScrollViewer>
    <Grid ColumnDefinitions="*,*" Margin="24,18,24,24">

      <!-- ========================= left: state and plans ========================= -->
      <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,10,0">

        <Border Classes="card hero" Classes.on="{Binding IsApplied}" Padding="20,18">
          <StackPanel Spacing="10">
            <TextBlock Text="Game mode" Classes="h2" />
            <TextBlock Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Active plan:" Classes="caption muted" />
              <TextBlock Text="{Binding ActivePlanName}" Classes="caption" FontWeight="SemiBold" />
            </StackPanel>

            <Button Classes="accent" HorizontalAlignment="Left" MinWidth="220" Margin="0,4,0,0"
                    Command="{Binding ToggleCommand}" Content="{Binding ToggleText}" />

            <Border Classes="notice warn" IsVisible="{Binding OnBattery}">
              <TextBlock Text="On battery. A gaming plan drains the battery faster." TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="notice" Classes.error="{Binding MessageIsError}"
                IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="card" Padding="16,14">
          <StackPanel Spacing="10">
            <TextBlock Text="Plan for games" Classes="h3" />

            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PlanChoices}" SelectedItem="{Binding GamePlan}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="abs:PowerPlan">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Classes="ghost" HorizontalAlignment="Left" IsVisible="{Binding CanAddUltimate}"
                    Command="{Binding AddUltimateCommand}"
                    ToolTip.Tip="The Windows plan without any power saving. Creating it requires administrator rights."
                    Content="Add &quot;Ultimate Performance&quot;" />

            <TextBlock Text="All plans" Classes="label" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding Plans}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PlanRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <Border Classes="badge" IsVisible="{Binding IsActive}">
                        <TextBlock Text="active" />
                      </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" IsVisible="{Binding !IsActive}"
                            Command="{Binding $parent[ItemsControl].((local:GameModeViewModel)DataContext).ActivatePlanCommand}"
                            CommandParameter="{Binding}"
                            Content="Activate" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16,14" IsVisible="{Binding OnlyOnePlan}">
          <StackPanel Spacing="8">
            <TextBlock Text="Only one power plan" Classes="h3" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="On devices with Modern Standby, Windows controls performance through the power mode in Settings." />
            <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding OpenPowerSettingsCommand}"
                    Content="Open power settings" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ========================= right: games ========================= -->
      <StackPanel Grid.Column="1" Spacing="14" Margin="10,0,0,0">

        <Border Classes="card" Padding="16,14">
          <StackPanel Spacing="10">
            <TextBlock Text="Games" Classes="h3" />
            <CheckBox IsChecked="{Binding Automatic}"
                      Content="Switch automatically while one of them runs" />

            <TextBlock Text="No games added yet." Classes="caption muted"
                       IsVisible="{Binding !HasGames}" />

            <ItemsControl ItemsSource="{Binding Games}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:GameRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Classes="mono" VerticalAlignment="Center" />
                      <Border Classes="badge running" IsVisible="{Binding IsRunning}">
                        <TextBlock Text="running" />
                      </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost icon"
                            Command="{Binding $parent[ItemsControl].((local:GameModeViewModel)DataContext).RemoveGameCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Remove">
                      <PathIcon Data="{DynamicResource IconClose}" Width="10" Height="10" Classes="muted" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
              <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                        ItemsSource="{Binding RunningApps}" SelectedItem="{Binding SelectedRunningApp}"
                        PlaceholderText="Running program"
                        ToolTip.Tip="Programs with a window that are running now" />
              <Button Grid.Column="1" Classes="ghost icon" Margin="0,0,4,0"
                      Command="{Binding RefreshAppsCommand}" ToolTip.Tip="Refresh list">
                <PathIcon Data="M12 4a8 8 0 0 0-7.4 5 1 1 0 1 0 1.8.8A6 6 0 0 1 17.7 9H15a1 1 0 1 0 0 2h5a1 1 0 0 0 1-1V5a1 1 0 1 0-2 0v2.3A8 8 0 0 0 12 4Zm-7 9a1 1 0 0 0-1 1v5a1 1 0 1 0 2 0v-2.3A8 8 0 0 0 19.4 15a1 1 0 1 0-1.8-.8A6 6 0 0 1 6.3 15H9a1 1 0 1 0 0-2H5Z"
                          Classes="small muted" />
              </Button>
              <Button Grid.Column="2" Classes="ghost" Command="{Binding AddRunningCommand}" Content="Add" />
            </Grid>

            <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding AddFromFileCommand}"
                    Content="Choose program file…" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16,14">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows Game Mode" Classes="h3" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding WindowsGameMode}" OnContent="" OffContent="" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption muted" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Windows gives a running game priority. Applies system-wide." />
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
