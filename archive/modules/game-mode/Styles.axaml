<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The top card carries the state. On means an accent border: color instead of movement. -->
  <Style Selector="Border.hero.on">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Border.notice.error">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <Style Selector="Border.notice.warn">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>

  <Style Selector="Border.badge.running">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>

  <Style Selector="Border.badge.running > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

</Styles>
