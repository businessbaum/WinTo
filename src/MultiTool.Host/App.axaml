<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MultiTool.Host.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MultiTool.UI/Theme/Palette.axaml" />
        <ResourceInclude Source="avares://MultiTool.UI/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MultiTool.UI/Theme/Controls.axaml" />
    <StyleInclude Source="/Views/ShellStyles.axaml" />
  </Application.Styles>

</Application>
