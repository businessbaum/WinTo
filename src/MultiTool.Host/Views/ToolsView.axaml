<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MultiTool.Host.ViewModels"
             xmlns:svc="using:MultiTool.Host.Services"
             xmlns:ui="using:MultiTool.UI"
             mc:Ignorable="d"
             x:Class="MultiTool.Host.Views.ToolsView"
             x:DataType="vm:ToolsViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- ================= Header ================= -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="28,20,28,6">
      <StackPanel Spacing="3" VerticalAlignment="Center">
        <TextBlock Text="Tools" Classes="h1" />
        <TextBlock Text="Opened when needed, most used first." Classes="caption" />
      </StackPanel>

      <Border Grid.Column="1" Classes="search" Width="300" VerticalAlignment="Center" Margin="16,0,8,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Grid.Column="0"
                    Data="{DynamicResource IconSearch}"
                    Classes="small muted"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center" />
          <TextBox Grid.Column="1"
                   Classes="plain"
                   Name="SearchBox"
                   PlaceholderText="Search tools"
                   VerticalAlignment="Center"
                   Text="{Binding SearchText}" />
          <Button Grid.Column="2"
                  Classes="ghost icon"
                  Width="22" Height="22"
                  Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <PathIcon Data="{DynamicResource IconClose}" Width="10" Height="10" Classes="muted" />
          </Button>
        </Grid>
      </Border>

      <Button Grid.Column="2"
              Classes="ghost icon"
              Command="{Binding RefreshStatusCommand}"
              IsEnabled="{Binding !IsScanning}"
              VerticalAlignment="Center"
              ToolTip.Tip="Refresh status">
        <PathIcon Data="{DynamicResource IconRefresh}" Classes="muted" />
      </Button>
    </Grid>

    <!-- ================= Tiles ================= -->
    <ScrollViewer Grid.Row="1" Padding="28,10,28,28">
      <StackPanel Spacing="24">

        <!-- Broken manifests are shown at the top, never hidden. -->
        <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:CatalogProblem">
              <Border Classes="card"
                      Padding="14"
                      Margin="0,0,0,8"
                      Background="{DynamicResource WarningSoftBrush}"
                      BorderBrush="{DynamicResource WarningBrush}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <PathIcon Data="{DynamicResource IconWarn}"
                            Foreground="{DynamicResource WarningBrush}"
                            VerticalAlignment="Top" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Message}" Classes="label" />
                    <TextBlock Text="{Binding Path}" Classes="mono muted" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="caption"
                   Text="No tool matches."
                   IsVisible="{Binding NothingFound}"
                   Margin="2,8,0,0" />

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="24" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TileGroup">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Label}" Classes="h3" Margin="2,0,0,0" IsVisible="{Binding HasLabel}" />

                <ItemsControl ItemsSource="{Binding Tiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <!-- Same column count for every group, so the tiles line up across categories. -->
                      <ui:AdaptiveGrid MinItemWidth="290" ColumnSpacing="12" RowSpacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>

                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TileViewModel">

                      <Button Classes="tile"
                              ToolTip.Tip="{Binding Tooltip}"
                              Command="{Binding $parent[UserControl].((vm:ToolsViewModel)DataContext).OpenCommand}"
                              CommandParameter="{Binding}">

                        <Panel>

                          <!-- The spinning border while the module works: a frame clipped to the tile, a rotating
                                                           conic gradient inside and a mask over all but two pixels. The negative
                                                           margin reaches past the padding to the tile's edge. Styles in
                                                           ShellStyles.axaml. -->
                          <Border Classes="busyRing"
                                  Margin="-15,-13"
                                  IsVisible="{Binding IsWorking}"
                                  IsHitTestVisible="False">
                            <Panel>
                              <Border Classes="busySweep" />
                              <Border Classes="busyMask" Margin="2" />
                            </Panel>
                          </Border>

                          <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="tileIcon" Background="{Binding AccentSoftBrush}" VerticalAlignment="Center">
                              <PathIcon Data="{Binding Icon}"
                                        Width="20" Height="20"
                                        Foreground="{Binding AccentBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalAlignment="Center">
                              <!-- Room on the right for the two hover buttons; Opacity 0 doesn't free space. -->
                              <TextBlock Text="{Binding Name}"
                                         Classes="tileName"
                                         TextTrimming="CharacterEllipsis"
                                         Margin="0,0,44,0" />
                              <TextBlock Text="{Binding Summary}"
                                         Classes="caption"
                                         TextWrapping="NoWrap"
                                         TextTrimming="CharacterEllipsis" />
                              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasStatus}" Margin="0,1,0,0">
                                <Ellipse Classes="dot"
                                         Width="6" Height="6"
                                         Classes.good="{Binding IsStatusGood}"
                                         Classes.warn="{Binding IsStatusWarn}"
                                         Classes.bad="{Binding IsStatusBad}"
                                         Classes.busy="{Binding IsStatusBusy}" />
                                <TextBlock Text="{Binding StatusText}"
                                           Classes="caption"
                                           FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </StackPanel>
                          </Grid>

                          <StackPanel Orientation="Horizontal"
                                      Spacing="1"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,-6,-8,0">
                            <Button Classes="tileAction"
                                    Classes.pinned="{Binding IsPinned}"
                                    Command="{Binding $parent[UserControl].((vm:ToolsViewModel)DataContext).TogglePinCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Pin">
                              <PathIcon Data="{DynamicResource IconPin}"
                                        Width="12" Height="12"
                                        Classes="muted" />
                            </Button>
                            <Button Classes="tileAction"
                                    Command="{Binding $parent[UserControl].((vm:ToolsViewModel)DataContext).OpenInWindowCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Open in its own window">
                              <PathIcon Data="{DynamicResource IconPopOut}"
                                        Width="12" Height="12"
                                        Classes="muted" />
                            </Button>
                          </StackPanel>

                        </Panel>
                      </Button>

                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
