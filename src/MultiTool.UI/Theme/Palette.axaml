<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Single source for colors and radii. The accent is mirrored into the Fluent system
       colors so sliders, toggle switches and focus rings match.

       Everything derived from the accent below is the default violet. AccentTheme.Apply
       recomputes all of it from the color chosen in Settings, so a new accent-dependent
       resource here also needs a line there. -->

  <!-- Surfaces, from low to high -->
  <Color x:Key="BgBaseColor">#101118</Color>
  <Color x:Key="BgSurfaceColor">#171922</Color>
  <Color x:Key="BgElevatedColor">#1E212C</Color>
  <Color x:Key="BgHoverColor">#262A37</Color>
  <Color x:Key="BgActiveColor">#2E3442</Color>

  <Color x:Key="BorderColor">#2C3140</Color>
  <Color x:Key="BorderStrongColor">#3C4356</Color>

  <Color x:Key="TextPrimaryColor">#ECEEF5</Color>
  <Color x:Key="TextSecondaryColor">#99A1B5</Color>
  <Color x:Key="TextMutedColor">#6C7488</Color>

  <Color x:Key="AccentColor">#7C5CFF</Color>
  <Color x:Key="AccentHoverColor">#8E72FF</Color>
  <Color x:Key="AccentPressedColor">#6A4BEF</Color>
  <Color x:Key="AccentSoftColor">#251F4A</Color>

  <Color x:Key="SuccessColor">#35D6A4</Color>
  <Color x:Key="SuccessSoftColor">#12332A</Color>
  <Color x:Key="WarningColor">#FFB454</Color>
  <Color x:Key="WarningSoftColor">#3A2A12</Color>
  <Color x:Key="DangerColor">#FF5C6E</Color>
  <Color x:Key="DangerSoftColor">#3A1A20</Color>

  <!-- Override Fluent system colors so one accent applies everywhere -->
  <Color x:Key="SystemAccentColor">#7C5CFF</Color>
  <Color x:Key="SystemAccentColorLight1">#8E72FF</Color>
  <Color x:Key="SystemAccentColorLight2">#A18BFF</Color>
  <Color x:Key="SystemAccentColorLight3">#B7A6FF</Color>
  <Color x:Key="SystemAccentColorDark1">#6A4BEF</Color>
  <Color x:Key="SystemAccentColorDark2">#5A3DD9</Color>
  <Color x:Key="SystemAccentColorDark3">#4A30B8</Color>

  <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBaseColor}" />
  <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
  <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
  <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
  <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource BgActiveColor}" />

  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

  <!-- Text and icons on an accent background: white, dark on a light accent. -->
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="OnAccentMutedBrush" Color="#D8FFFFFF" />

  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#8E72FF" />
    <GradientStop Offset="1" Color="#5A3DD9" />
  </LinearGradientBrush>

  <!-- The logo plate, near black: the white switch on it is the contrast. Same stops as tools\IconGen.
       The accent color doesn't touch it: the logo in the header matches the icon in the taskbar. -->
  <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#3A3A44" />
    <GradientStop Offset="0.5" Color="#1C1C22" />
    <GradientStop Offset="1" Color="#0A0A0D" />
  </LinearGradientBrush>

  <!-- The traveling arc around a busy tile: a quarter turn bright, the rest transparent. -->
  <ConicGradientBrush x:Key="BusySweepBrush">
    <GradientStop Offset="0.00" Color="#007C5CFF" />
    <GradientStop Offset="0.14" Color="#7C5CFF" />
    <GradientStop Offset="0.26" Color="#C0A8FF" />
    <GradientStop Offset="0.40" Color="#007C5CFF" />
    <GradientStop Offset="1.00" Color="#007C5CFF" />
  </ConicGradientBrush>

  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">14</CornerRadius>
  <CornerRadius x:Key="RadiusXl">18</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Fluent theme resource overrides. Application.Resources wins over theme styles, so
       these keys apply to TextBox / ComboBox / Slider / ToggleSwitch without template internals. -->

  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource BgElevatedColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource BgHoverColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource BgElevatedColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource BgSurfaceColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource AccentColor}" />

  <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource BgElevatedColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource BgHoverColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource BgActiveColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource BgSurfaceColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource BgElevatedColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource BgHoverColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource AccentSoftColor}" />

  <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource AccentPressedColor}" />

  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{StaticResource BgBaseColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource BorderStrongColor}" />

  <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
  <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="{StaticResource BorderStrongColor}" />

</ResourceDictionary>
