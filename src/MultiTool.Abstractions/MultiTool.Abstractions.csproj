<Project Sdk="Microsoft.NET.Sdk">

  <!-- The contract between host and modules. Always loaded in the default context and
       shared by every module, so everything public here is ABI. -->

  <PropertyGroup>
    <RootNamespace>MultiTool.Abstractions</RootNamespace>
    <AssemblyName>MultiTool.Abstractions</AssemblyName>

    <!-- LibraryImport generates pointer marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

</Project>
