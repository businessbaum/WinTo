<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:MultiTool.Modules.Apps.Uninstaller"
             mc:Ignorable="d"
             x:Class="MultiTool.Modules.Apps.Uninstaller.UninstallerView"
             x:DataType="local:UninstallerViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://MultiTool.Modules.Apps/Uninstaller/Styles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,24">

    <!-- ============================ Header ============================ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
      <Border Grid.Column="0" Classes="search" Margin="0,0,12,0">
        <TextBox Text="{Binding Search}" Classes="plain"
                 PlaceholderText="Search name or publisher" />
      </Border>

      <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Classes="caption muted"
                 VerticalAlignment="Center" Margin="0,0,12,0" />

      <Button Grid.Column="2" Classes="ghost" Margin="0,0,8,0"
              IsVisible="{Binding CanElevate}"
              Command="{Binding ElevateCommand}"
              ToolTip.Tip="Restarts WinTo with administrator rights. Leftovers under Program Files and HKLM need administrator rights."
              Content="As administrator" />

      <Button Grid.Column="3" Classes="ghost"
              IsEnabled="{Binding !IsLoading}"
              Command="{Binding RefreshCommand}"
              Content="Reload" />
    </Grid>

    <Border Grid.Row="1" Classes="notice" Margin="0,0,0,12"
            Classes.noticeError="{Binding MessageIsError}"
            IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>

    <!-- ====================== List and details ====================== -->
    <Grid Grid.Row="2" ColumnDefinitions="*,420">

      <Border Grid.Column="0" Classes="card" Padding="6" Margin="0,0,16,0">
        <ListBox ItemsSource="{Binding Programs}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:InstalledProgram">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Publisher}" Classes="caption muted"
                               TextTrimming="CharacterEllipsis" MaxWidth="240" />
                    <TextBlock Text="{Binding Version}" Classes="caption muted" />
                  </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="caption muted mono"
                           VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="2" Text="{Binding InstalledText}" Classes="caption muted"
                           VerticalAlignment="Center" Width="80" TextAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- ============================ Right ============================ -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">

        <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
          <StackPanel Spacing="12">

            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Selected.Name, FallbackValue='Nothing selected'}"
                         Classes="h2" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Selected.Publisher}" Classes="caption muted" />
            </StackPanel>

            <StackPanel Spacing="6"
                        IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="Version" Classes="label" />
                <TextBlock Grid.Column="1" Text="{Binding Selected.Version}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="Size" Classes="label" />
                <TextBlock Grid.Column="1" Text="{Binding Selected.SizeText}" />
              </Grid>
              <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="Installed" Classes="label" />
                <TextBlock Grid.Column="1" Text="{Binding Selected.InstalledText}" />
              </Grid>
              <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="Applies to" Classes="label" />
                <TextBlock Grid.Column="1" Text="{Binding Selected.ScopeText}" />
              </Grid>
              <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="Folder" Classes="label" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Selected.InstallLocation}"
                                     Classes="mono caption muted" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Button Classes="danger" Command="{Binding UninstallCommand}" Content="Uninstall" />
              <Button Classes="ghost" Command="{Binding ScanSelectedCommand}"
                      IsEnabled="{Binding !IsScanning}"
                      ToolTip.Tip="Also searches without uninstalling first. For programs removed by hand."
                      Content="Find leftovers" />
              <Button Classes="ghost" Command="{Binding RevealCommand}"
                      CommandParameter="{Binding Selected}" Content="Folder" />
            </StackPanel>

          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*,Auto">

            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Leftovers" Classes="h2" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="Cancel"
                        IsVisible="{Binding IsScanning}"
                        Command="{Binding CancelScanCommand}" />
              </Grid>

              <TextBlock Classes="caption muted" TextWrapping="Wrap"
                         Text="Found by name. Check before removing." />

              <TextBlock Classes="caption" Foreground="{DynamicResource AccentBrush}"
                         Text="{Binding ScannedFor, StringFormat='Searched for: {0}'}"
                         IsVisible="{Binding ScannedFor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Classes="list">
              <ItemsControl ItemsSource="{Binding Leftovers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:LeftoverRow">
                    <Border Classes="leftover" Classes.sure="{Binding IsHigh}" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" Margin="0,0,8,0"
                                  VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Path}" Classes="mono caption" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="badge" Padding="7,1">
                              <TextBlock Text="{Binding KindText}" />
                            </Border>
                            <TextBlock Text="{Binding Reason}" Classes="caption muted"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="caption muted mono"
                                   VerticalAlignment="Top" Margin="8,0,0,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                        IsVisible="{Binding HasLeftovers}">
              <Button Classes="danger" Command="{Binding RemoveLeftoversCommand}"
                      Content="Remove checked" />
              <Button Classes="ghost" Command="{Binding OpenBackupsCommand}"
                      ToolTip.Tip="Before registry keys are deleted, a .reg file is stored here. Double-click restores the keys."
                      Content="Backups" />
            </StackPanel>

          </Grid>
        </Border>
      </Grid>
    </Grid>

  </Grid>
</UserControl>
