<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MultiTool.Modules.Storage.Cleanup"
             x:Class="MultiTool.Modules.Storage.Cleanup.CleanupView"
             x:DataType="local:CleanupViewModel">

  <UserControl.Styles>
    <Style Selector="Border.cleanRow">
      <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.size">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="600" />
      <Setter Property="MinWidth" Value="90" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto" Margin="24,18,24,24" MaxWidth="884" HorizontalAlignment="Left">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,24,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:CleanupRow">
            <Border Classes="cleanRow">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,6,0"
                          IsEnabled="{Binding !$parent[UserControl].((local:CleanupViewModel)DataContext).IsBusy}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="600" />
                  <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Note}" Classes="caption note" TextWrapping="Wrap"
                             IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="size" Margin="16,0,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,24,0">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="{Binding TotalText}" FontWeight="600" />
        <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Content="Measure again" Command="{Binding RefreshCommand}" IsVisible="{Binding !IsBusy}" />
        <Button Classes="ghost" Content="Stop" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        <Button Classes="accent" Content="Clean up…" Command="{Binding CleanCommand}" IsEnabled="{Binding !IsBusy}"
                ToolTip.Tip="Deletes permanently. Nothing goes to the recycle bin." />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
