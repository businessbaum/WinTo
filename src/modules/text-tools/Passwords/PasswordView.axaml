<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:MultiTool.Modules.TextTools.Passwords"
             xmlns:sys="using:System"
             mc:Ignorable="d"
             x:Class="MultiTool.Modules.TextTools.Passwords.PasswordView"
             x:DataType="local:PasswordViewModel">

  <!-- The base look comes from MultiTool.UI in the default context. Module-only styles live in
              the module's own Styles.axaml, included from here and so only once the module is
              loaded. Never from the shell: one StyleInclude in App.axaml would load the DLL at startup. -->
  <UserControl.Styles>
    <StyleInclude Source="avares://MultiTool.Modules.TextTools/Passwords/Styles.axaml" />
  </UserControl.Styles>


  <Grid ColumnDefinitions="340,*">

    <!-- ================= Settings ================= -->
    <ScrollViewer Grid.Column="0" Padding="24,20,16,24">
      <StackPanel Spacing="18">

        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Length" Classes="label" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Length}"
                       Classes="mono"
                       FontSize="14"
                       VerticalAlignment="Center" />
          </Grid>
          <Slider Minimum="4" Maximum="128" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Length}" />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Character groups" Classes="label" />
          <CheckBox Content="Lowercase  a–z" IsChecked="{Binding UseLower}" />
          <CheckBox Content="Uppercase  A–Z" IsChecked="{Binding UseUpper}" />
          <CheckBox Content="Digits  0–9" IsChecked="{Binding UseDigits}" />
          <CheckBox Content="Symbols" IsChecked="{Binding UseSymbols}" />
          <TextBox Text="{Binding Symbols}"
                   IsEnabled="{Binding UseSymbols}"
                   Classes="mono"
                   Margin="26,2,0,0"
                   ToolTip.Tip="Symbol set. Duplicates are ignored." />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Details" Classes="label" />
          <CheckBox IsChecked="{Binding RequireEachGroup}"
                    Content="Every group must appear"
                    ToolTip.Tip="Met by rejecting and redrawing. The entropy shown accounts for the condition exactly." />
          <CheckBox IsChecked="{Binding ExcludeAmbiguous}"
                    Content="Leave out ambiguous characters"
                    ToolTip.Tip="Without I l 1 O 0 o and the vertical bar. Easier to type and read aloud, costs entropy." />
        </StackPanel>

        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Count" Classes="label" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="mono" VerticalAlignment="Center" />
          </Grid>
          <Slider Minimum="1" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Count}" />
        </StackPanel>

        <Button Classes="accent"
                HorizontalAlignment="Stretch"
                Command="{Binding GenerateCommand}"
                Content="Generate again" />

      </StackPanel>
    </ScrollViewer>

    <!-- ================= Result ================= -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="8,20,24,24">

      <Border Grid.Row="0" Classes="card" Padding="16" Margin="0,0,0,14">
        <StackPanel Spacing="10">

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding EntropyText}" Classes="h2" />
              <TextBlock Text="{Binding AlphabetText}" Classes="caption" />
            </StackPanel>
            <Border Grid.Column="1" Classes="badge" Padding="10,4" VerticalAlignment="Top">
              <TextBlock Text="{Binding RatingLabel}"
                         FontWeight="600"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
          </Grid>

          <!-- A bar of five segments. A ProgressBar would suggest a precision the rating doesn't have:
                              the limits are convention. -->
          <ProgressBar Minimum="0" Maximum="4"
                       Value="{Binding RatingLevel}"
                       Height="4"
                       CornerRadius="2"
                       Foreground="{DynamicResource AccentBrush}"
                       Background="{DynamicResource BgElevatedBrush}" />

          <TextBlock Text="{Binding CrackText}" Classes="caption muted" />

          <Border Classes="badge"
                  Padding="10,5"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource WarningSoftBrush}"
                  BorderBrush="{DynamicResource WarningBrush}"
                  IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Warning}"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap" />
          </Border>

        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Classes="list">
        <ItemsControl x:Name="Rows" ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <Border Classes="pwRow" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <SelectableTextBlock Grid.Column="0"
                                       Text="{Binding}"
                                       Classes="mono"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                  <Button Grid.Column="1"
                          Classes="ghost pwCopy"
                          Content="Copy"
                          Command="{Binding $parent[UserControl].((local:PasswordViewModel)DataContext).CopyCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Grid.Row="2"
                 Text="{Binding Toast}"
                 Classes="caption"
                 Foreground="{DynamicResource SuccessBrush}"
                 Margin="2,10,0,0"
                 IsVisible="{Binding Toast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Grid>
  </Grid>
</UserControl>
