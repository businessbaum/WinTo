<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:MultiTool.Modules.TextTools"
             xmlns:pw="using:MultiTool.Modules.TextTools.Passwords"
             mc:Ignorable="d"
             x:Class="MultiTool.Modules.TextTools.TextToolsView"
             x:DataType="local:TextToolsViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://MultiTool.Modules.TextTools/Styles.axaml" />
  </UserControl.Styles>

  <Grid ColumnDefinitions="200,*" Margin="24,18,24,24">

    <!-- Tool list -->
    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
      <ItemsControl ItemsSource="{Binding Tools}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ToolEntry">
            <Button Classes="tool" Classes.toolActive="{Binding IsActive}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,4"
                    Command="{Binding $parent[ItemsControl].((local:TextToolsViewModel)DataContext).SelectSectionCommand}"
                    CommandParameter="{Binding Index}"
                    Content="{Binding Name}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>

    <!-- The password generator: its own layout instead of input and output. -->
    <pw:PasswordView Grid.Column="1" DataContext="{Binding Passwords}" IsVisible="{Binding $parent[UserControl].((local:TextToolsViewModel)DataContext).IsPasswords}" />

    <!-- Work area -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,*" IsVisible="{Binding IsTextTool}">

      <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
        <TextBlock Text="{Binding Current.Name}" Classes="h2" />
        <TextBlock Text="{Binding Hint}" Classes="caption muted" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Buttons per tool -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">

        <!-- Checksum -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsHash}">
          <Button Classes="accent" Command="{Binding HashTextCommand}" CommandParameter="Sha256" Content="SHA-256" />
          <Button Classes="ghost" Command="{Binding HashTextCommand}" CommandParameter="Sha1" Content="SHA-1" />
          <Button Classes="ghost" Command="{Binding HashTextCommand}" CommandParameter="Md5" Content="MD5" />
          <Button Classes="ghost" Command="{Binding HashTextCommand}" CommandParameter="Sha512" Content="SHA-512" />
          <Button Classes="ghost" Command="{Binding HashFileCommand}" CommandParameter="Sha256"
                  ToolTip.Tip="Reads the file as a stream; even an 8 GB image works without filling memory."
                  Content="File…" />
        </StackPanel>

        <!-- Base64 and URL share two buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBase64}">
          <Button Classes="accent" Command="{Binding EncodeCommand}" Content="Encode" />
          <Button Classes="ghost" Command="{Binding DecodeCommand}" Content="Decode" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsUrl}">
          <Button Classes="accent" Command="{Binding EncodeCommand}" Content="Encode" />
          <Button Classes="ghost" Command="{Binding DecodeCommand}" Content="Decode" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsJson}">
          <Button Classes="accent" Command="{Binding EncodeCommand}" Content="Indent" />
          <Button Classes="ghost" Command="{Binding DecodeCommand}" Content="One line" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsTime}">
          <Button Classes="accent" Command="{Binding ConvertCommand}" Content="Convert" />
          <Button Classes="ghost" Command="{Binding NowCommand}" Content="Now" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsUuid}">
          <Button Classes="accent" Command="{Binding GenerateCommand}" Content="Generate" />
          <NumericUpDown Value="{Binding Count}" Minimum="1" Maximum="100" Increment="1"
                         Width="110" FormatString="0" VerticalAlignment="Center" />
          <TextBlock Text="count" Classes="caption muted" VerticalAlignment="Center" />
        </StackPanel>

        <Button Classes="ghost" Command="{Binding PasteCommand}" Content="Paste"
                IsVisible="{Binding HasInput}" />
        <Button Classes="ghost" Command="{Binding ClearCommand}" Content="Clear" />
      </StackPanel>

      <!-- Input -->
      <TextBox Grid.Row="2"
               Text="{Binding Input}"
               IsVisible="{Binding HasInput}"
               Classes="mono"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               PlaceholderText="Input"
               VerticalContentAlignment="Top" />

      <Border Grid.Row="3" Classes="notice" Classes.noticeError="{Binding MessageIsError}"
              Margin="0,12,0,0"
              IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>

      <!-- Output -->
      <Grid Grid.Row="4" RowDefinitions="Auto,*" Margin="0,12,0,0" IsVisible="{Binding HasOutput}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Text="Result" Classes="label" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Command="{Binding CopyCommand}" Content="Copy" />
        </Grid>

        <Border Grid.Row="1" Classes="output">
          <ScrollViewer Classes="list">
            <SelectableTextBlock Text="{Binding Output}" Classes="mono" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
