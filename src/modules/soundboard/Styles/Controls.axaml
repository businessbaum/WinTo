<Styles xmlns="https://github.com/avaloniaui"
        xmlns:ui="using:MultiTool.UI"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================= Typography ================= -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="600" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="600" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="500" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ================= Cards / surfaces ================= -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Margin" Value="0,14" />
  </Style>

  <!-- ================= Buttons ================= -->

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="500" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- soft transitions -->
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <ui:SmoothBrushTransition Property="Background" Duration="0:0:0.13" />
        <ui:SmoothBrushTransition Property="BorderBrush" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgActiveBrush}" />
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- Accent -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="600" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <!-- Ghost -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Danger (ghost variant, turns red only on hover) -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- square icon button.
              MinHeight/MinWidth deliberately 0: the base Button style forces 36 px height otherwise,
              and a smaller button would become a stretched rectangle with a distorted icon. -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <!-- round play/stop button in the sound row -->
  <Style Selector="Button.play">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.play.playing">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.play.playing:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <!-- hotkey chip -->
  <Style Selector="Button.chip">
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Background" Value="{DynamicResource BgBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
  </Style>
  <Style Selector="Button.chip.assigned">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Button.chip.recording">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <!-- ================= Icons ================= -->

  <Style Selector="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="PathIcon.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="PathIcon.onAccent">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="PathIcon.small">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- ================= Input fields ================= -->

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- borderless TextBox: for search field and inline rename.
              Must target the template border, because the Fluent theme sets its background per
              state. Our styles run afterwards and win. -->
  <Style Selector="TextBox.plain /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.plain">
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="TextBox.inline /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.inline:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
  </Style>
  <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource BgBaseBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox.inline">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Margin" Value="-6,0,0,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="500" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <!-- search field border -->
  <Style Selector="Border.search">
    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="10,0,10,0" />
    <Setter Property="Height" Value="36" />
  </Style>

  <!-- small loop toggle in the sound row -->
  <Style Selector="ToggleButton.iconToggle">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <!-- ToggleButton inherits from Button and with it its MinHeight of 36. -->
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.iconToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.iconToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <!-- Avalonia aligns the ComboBox to the top by default. Next to taller neighbors in a row
                  it sticks to the top edge instead of centering. -->
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <!-- Slider for a row of buttons and pickers.

           A Slider takes 48 px height by itself: the template reserves space above and below for
           a tick bar we don't use. In a 36 px row that breaks the row height and everything shifts
           when it appears.

           Squeezing it to 36 px fails: the template only trims the bottom and the thumb drops 6 px
           off center. So it keeps its full height and overhangs the row invisibly; the thumb stays
           centered and the surrounding border sets the row height. -->
  <Style Selector="Slider.compact">
    <Setter Property="Height" Value="48" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ================= Tabs (own template, no reliance on theme internals) ================= -->

  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabControl > ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="500" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="TabRoot"
                Background="Transparent"
                Padding="0,0,0,0">
          <Grid RowDefinitions="*,2">
            <Border Name="TabHover"
                    Grid.Row="0"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="14,9"
                    Margin="0,0,0,6">
              <ContentPresenter Name="TabLabel"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <Border Name="TabPipe"
                    Grid.Row="1"
                    Height="2"
                    CornerRadius="1"
                    Background="Transparent" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabItem /template/ Border#TabHover">
    <Setter Property="Transitions">
      <Transitions>
        <ui:SmoothBrushTransition Property="Background" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TabItem /template/ ContentPresenter#TabLabel">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TabItem:pointerover /template/ Border#TabHover">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ ContentPresenter#TabLabel">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TabItem:selected /template/ ContentPresenter#TabLabel">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#TabPipe">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ================= Sound list ================= -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
  </Style>
  <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- the actual row look lives in the DataTemplate -->
  <Style Selector="Border.soundRow">
    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Transitions">
      <Transitions>
        <ui:SmoothBrushTransition Property="Background" Duration="0:0:0.13" />
        <ui:SmoothBrushTransition Property="BorderBrush" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.soundRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Border.soundRow.playing">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
  </Style>

  <!-- ================= Playback bar ================= -->

  <Style Selector="Border.player">
    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style Selector="ProgressBar.player">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource BgBaseBrush}" />
  </Style>

  <!-- ================= Folder tree ================= -->

  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="IsExpanded" Value="True" />
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- folder row -->
  <Style Selector="Border.folderRow">
    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Transitions">
      <Transitions>
        <ui:SmoothBrushTransition Property="Background" Duration="0:0:0.13" />
        <ui:SmoothBrushTransition Property="BorderBrush" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.folderRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Border.folderRow.dropTarget">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Drag handle. Needs its own area because name field, slider and buttons claim the
              pointer for themselves. -->
  <Style Selector="Border.grip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeAll" />
    <Setter Property="Width" Value="18" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ToolTip.Tip" Value="Zum Verschieben ziehen" />
  </Style>
  <Style Selector="Border.grip > PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.grip:pointerover > PathIcon">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <!-- expand arrow -->
  <Style Selector="PathIcon.chevron">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="PathIcon.chevron.expanded">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>

  <!-- ================= Status pills ================= -->

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.pill.ok">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.pill.warn">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.pill.bad">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- ================= Scrollbars ================= -->

  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

</Styles>
