<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Sort bar, the same buttons as the Windows overview section bar. -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
  </Style>

  <Style Selector="Button.navActive">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="600" />
  </Style>

  <Style Selector="Button.navActive /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Button.navActive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- The process rows. Tighter than a card: three hundred stacked, any border would repeat
              three hundred times. -->
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <!-- "protected" and "critical" in warning color, not red. Red means error; a PPL process is
           a statement: it won't end, on purpose. The note is in the row before anyone tries. -->
  <Style Selector="Border.badge.badgeGuard">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.badge.badgeGuard > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Border.notice > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.noticeWarn">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.noticeWarn > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

</Styles>
