<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:MultiTool.Modules.Files.Metadata"
             mc:Ignorable="d"
             x:Class="MultiTool.Modules.Files.Metadata.MetadataCleanerView"
             x:DataType="local:MetadataCleanerViewModel"
             DragDrop.AllowDrop="True">

  <UserControl.Styles>
    <StyleInclude Source="avares://MultiTool.Modules.Files/Metadata/Styles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- ============================ Bar ============================ -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="24,18,24,12">

      <Button Grid.Column="0" Classes="ghost" Margin="0,0,8,0"
              Command="{Binding AddFilesCommand}"
              Content="Choose files" />

      <Button Grid.Column="1" Classes="ghost"
              IsEnabled="{Binding HasFiles}"
              Command="{Binding ClearCommand}"
              Content="Clear list" />

      <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="caption muted"
                 VerticalAlignment="Center" Margin="16,0" />

      <CheckBox Grid.Column="3" Margin="0,0,16,0"
                IsChecked="{Binding ReplaceOriginal}"
                Content="Replace original"
                ToolTip.Tip="On: the file is overwritten, no copy. Off: a new file next to it, the original stays." />

      <Button Grid.Column="4" Classes="accent"
              IsVisible="{Binding !IsWorking}"
              IsEnabled="{Binding HasFiles}"
              Command="{Binding CleanCommand}"
              Content="Clean" />

      <Button Grid.Column="5" Classes="danger"
              IsVisible="{Binding IsWorking}"
              Command="{Binding CancelCommand}"
              Content="Cancel" />
    </Grid>

    <Border Grid.Row="1" Classes="notice" Margin="24,0,24,12"
            Classes.noticeError="{Binding MessageIsError}"
            IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>

    <!-- ==================== Files and details ==================== -->
    <Grid Grid.Row="2" ColumnDefinitions="400,*" Margin="24,0,24,24">

      <Border Grid.Column="0" x:Name="Zone" Classes="dropZone" Margin="0,0,16,0">
        <Grid>

          <!-- Only while the list is empty. -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" IsVisible="{Binding !HasFiles}">
            <TextBlock Text="Drop files here" Classes="h3" HorizontalAlignment="Center" />
            <TextBlock Classes="caption muted" HorizontalAlignment="Center" TextAlignment="Center"
                       MaxWidth="280" TextWrapping="Wrap"
                       Text="Images keep their quality. Videos need ffmpeg." />
          </StackPanel>

          <ListBox ItemsSource="{Binding Files}"
                   SelectedItem="{Binding Selected}"
                   Background="Transparent"
                   BorderThickness="0"
                   IsVisible="{Binding HasFiles}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:FileRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding KindText}" Classes="caption muted" />
                      <TextBlock Text="{Binding SizeText}" Classes="caption muted" />
                      <TextBlock Text="{Binding StatusText}" Classes="caption"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </StackPanel>

                  <Border Grid.Column="1" Classes="badge warn" Padding="8,2"
                          VerticalAlignment="Center"
                          IsVisible="{Binding HasSensitive}">
                    <TextBlock Text="sensitive" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,*,Auto">

          <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
            <TextBlock Text="{Binding Selected.Name, FallbackValue='Nothing selected'}" Classes="h2"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Selected.Path}" Classes="caption muted mono"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Classes="list">
            <StackPanel Spacing="8">

              <TextBlock Classes="caption muted"
                         IsVisible="{Binding !HasDetails}"
                         Text="No entries found." />

              <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:MetadataEntry">
                    <Grid ColumnDefinitions="90,140,*" Margin="0,0,0,6">
                      <Border Grid.Column="0" Classes="badge" Padding="8,2"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Classes.warn="{Binding Sensitive}">
                        <TextBlock Text="{Binding Group}" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="label"
                                 Margin="10,2,10,0" TextWrapping="Wrap" />
                      <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" Classes="mono"
                                           Margin="0,2,0,0" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0"
                      IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Button Classes="ghost" Content="Show in Explorer"
                    Command="{Binding RevealCommand}" CommandParameter="{Binding Selected}" />
            <Button Classes="ghost" Content="Remove from list"
                    Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}" />
          </StackPanel>

        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>
