<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:MultiTool.Modules.YouTube"
             xmlns:sys="using:System"
             mc:Ignorable="d"
             x:Class="MultiTool.Modules.YouTube.YouTubeView"
             x:DataType="local:YouTubeViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://MultiTool.Modules.YouTube/Styles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- ========================== Tools ========================== -->
    <Border Grid.Row="0" Classes="toolbar" Margin="24,18,24,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                 Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding ToolsReady}" />
        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                 Fill="{DynamicResource WarningBrush}" IsVisible="{Binding !ToolsReady}" />

        <TextBlock Grid.Column="1" Text="{Binding ToolText}" Classes="caption"
                   VerticalAlignment="Center" TextWrapping="Wrap" />

        <Button Grid.Column="3" Classes="ghost" Margin="12,0,0,0"
                IsVisible="{Binding ToolsReady}"
                IsEnabled="{Binding !IsFetchingTool}"
                Command="{Binding UpdateToolCommand}"
                ToolTip.Tip="Runs yt-dlp's update command. yt-dlp goes stale with every change on YouTube."
                Content="Update" />
      </Grid>
    </Border>

    <!-- ========================== Input ========================== -->
    <StackPanel Grid.Row="1" Margin="24,14,24,0" Spacing="12">

      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0"
                 Text="{Binding Url}"
                 PlaceholderText="URL: video, playlist or channel"
                 Margin="0,0,8,0" />
        <Button Grid.Column="1" Classes="accent"
                IsEnabled="{Binding !IsInspecting}"
                Command="{Binding AddCommand}"
                Content="Add" />
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">

        <ToggleSwitch Grid.Column="0" Margin="0,0,6,0"
                      IsChecked="{Binding AudioOnly}"
                      VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="label" VerticalAlignment="Center" Margin="0,0,18,0"
                   Text="audio only" />

        <ComboBox Grid.Column="2" Width="110" Margin="0,0,8,0"
                  IsVisible="{Binding AudioOnly}"
                  ItemsSource="{Binding AudioFormats}"
                  SelectedItem="{Binding AudioFormat}" />

        <ComboBox Grid.Column="2" Width="110" Margin="0,0,8,0"
                  IsVisible="{Binding !AudioOnly}"
                  ItemsSource="{Binding Qualities}"
                  SelectedItem="{Binding Quality}" />

        <CheckBox Grid.Column="3"
                  IsChecked="{Binding WholePlaylist}"
                  Content="whole playlist"
                  ToolTip.Tip="Off: from a playlist URL only the linked video is downloaded." />

        <TextBlock Grid.Column="4" Text="{Binding TargetDirectory}" Classes="caption muted mono"
                   VerticalAlignment="Center" Margin="18,0" TextTrimming="CharacterEllipsis" />

        <Button Grid.Column="5" Classes="ghost" Margin="0,0,8,0"
                Command="{Binding PickFolderCommand}" Content="Target folder" />
        <Button Grid.Column="6" Classes="ghost"
                Command="{Binding OpenFolderCommand}" Content="Open" />
      </Grid>

      <Border Classes="notice" Classes.noticeError="{Binding MessageIsError}"
              IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <!-- ========================== Controls ========================== -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="24,14,24,10">
      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
        <TextBlock Classes="h3" Text="Queue" />
        <TextBlock Text="{Binding QueueHint}" Classes="caption"
                   Foreground="{DynamicResource AccentBrush}"
                   IsVisible="{Binding HasQueueHint}" />
      </StackPanel>

      <Button Grid.Column="1" Classes="ghost" Margin="0,0,8,0"
              Command="{Binding ClearDoneCommand}"
              Content="Remove finished" />

      <Button Grid.Column="2" Classes="accent"
              Classes.callToAction="{Binding HasQueueHint}"
              IsVisible="{Binding !IsBusy}"
              IsEnabled="{Binding ToolsReady}"
              Command="{Binding StartCommand}"
              Content="Download" />

      <Button Grid.Column="2" Classes="danger"
              IsVisible="{Binding IsBusy}"
              Command="{Binding CancelCommand}"
              Content="Cancel" />
    </Grid>

    <!-- ==================== Queue and log ==================== -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="24,0,24,24">

      <ScrollViewer Grid.Column="0" Margin="0,0,16,0">
        <StackPanel Spacing="8">

          <TextBlock Classes="caption muted" IsVisible="{Binding !HasJobs}" TextWrapping="Wrap"
                     Text="Nothing in the list yet. Add a URL above." />

          <ItemsControl ItemsSource="{Binding Jobs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:DownloadJob">
                <Border Classes="job" Margin="0,0,0,8">
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto">

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}"
                               FontWeight="600" TextTrimming="CharacterEllipsis" />

                    <Border Grid.Row="0" Grid.Column="1" Classes="badge" Padding="9,3" Margin="10,0,8,0"
                            Classes.badgeLive="{Binding ShowProgress}">
                      <TextBlock Text="{Binding StateText}" />
                    </Border>

                    <Button Grid.Row="0" Grid.Column="2" Classes="ghost jobAction"
                            Content="✕"
                            Command="{Binding $parent[UserControl].((local:YouTubeViewModel)DataContext).RemoveJobCommand}"
                            CommandParameter="{Binding}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="{Binding Subtitle}" Classes="caption muted"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="5" Margin="0,10,0,0">
                      <ProgressBar Height="4" CornerRadius="2" Minimum="0" Maximum="1"
                                   Value="{Binding Progress}"
                                   IsVisible="{Binding ShowProgress}"
                                   IsIndeterminate="{Binding !ProgressIsKnown}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Background="{DynamicResource BgElevatedBrush}" />

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="caption muted"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Classes="ghost" Content="Show"
                                IsVisible="{Binding IsDone}"
                                Command="{Binding $parent[UserControl].((local:YouTubeViewModel)DataContext).RevealCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </StackPanel>

                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- The yt-dlp output only takes room once there is some. -->
      <Border Grid.Column="1" Classes="card" Padding="12" Width="340" Margin="16,0,0,0" IsVisible="{Binding HasLog}">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="yt-dlp output" Classes="label" Margin="0,0,0,8" />
          <ScrollViewer Grid.Row="1" x:Name="LogScroller" Classes="list">
            <ItemsControl ItemsSource="{Binding Log}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Text="{Binding}" Classes="mono caption muted"
                             TextWrapping="Wrap" Margin="0,0,0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>
